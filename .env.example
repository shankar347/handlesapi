NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# MongoDB — local install or Atlas (no Docker required)
# Prefer a DB name in the path, e.g. ...mongodb.net/handles
MONGODB_URI=mongodb://127.0.0.1:27017/handles
MONGO_URI=

# Redis (Phase 6+ presence / Socket.IO adapter) — optional
REDIS_URL=redis://127.0.0.1:6379

# JWT (Phase 2) — replace with long random secrets
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Media (Phase 3) — Cloudinary or S3
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# Firebase Admin (push notifications)
# Option A: individual fields
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Option B: full service-account JSON string
FIREBASE_SERVICE_ACCOUNT_JSON=


# Google / Apple auth (Phase 2)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
